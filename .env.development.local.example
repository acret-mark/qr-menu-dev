# Template for `.env.development.local` — copy this file to `.env.development.local` (gitignored)
# and fill in the real values. Next.js loads `.env.development.local` with higher priority than
# `.env.local` when running `next dev`, so this file's values override the Vercel-pulled production
# config in `.env.local` without ever touching it. See specs/034-local-dev-environment/ (ai_workspace)
# and README.md's "Local Development" section.
#
# DO NOT put production credentials in the real .env.development.local. DO NOT commit the real
# .env.development.local (only this .example file is committed).

# ── Supabase — local CLI stack ──────────────────────────────────────────────
# Run `npm run db:start`, then `npx supabase status` to get these values fresh
# (the keys below are the local stack's fixed demo keys, safe to keep as-is).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<run `npx supabase status` and paste PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<run `npx supabase status` and paste SECRET_KEY>

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=local-dev-only-secret

# ── Cloudinary — sandbox account, NOT the production one ───────────────────
# See specs/034-local-dev-environment/research.md #6. Only needed for local image-upload testing.
CLOUDINARY_CLOUD_NAME=<sandbox account cloud_name>
CLOUDINARY_API_KEY=<sandbox account API key>
CLOUDINARY_API_SECRET=<sandbox account API secret>

# ── Email — sandbox Gmail account, NOT one that can reach real owners ──────
# See specs/034-local-dev-environment/research.md #6. Only needed for local email testing.
GMAIL_SMTP_USER=<sandbox Gmail address>
GMAIL_SMTP_APP_PASSWORD=<sandbox Gmail app password>

# ── AI / translation — same keys as .env.local are acceptable ─────────────
# Stateless calls, no persistent side effect and no tenant-data exposure risk beyond the item
# text itself (which is synthetic seed data). See research.md #6.
DEEPL_API_KEY=<copy from .env.local, or request a dev key later>
GEMINI_API_KEY=<copy from .env.local, or request a dev key later>
ANTHROPIC_API_KEY=<copy from .env.local, or request a dev key later>
